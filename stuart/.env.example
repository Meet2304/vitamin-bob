# Set these in PowerShell; this file is documentation and is not automatically loaded.
VB_BOB_URL=http://127.0.0.1:8100
VB_STUART_URL=http://127.0.0.1:8200
# Absolute shared data directory after merge:
# VB_DATA_DIR=D:\Projects_Ad Astra\Project_25_Vitamin Bob\vitamin-bob\data
VB_SIM_LINES=1
VB_SIM_MODE=scripted
VB_SIM_DIGITS=["1","2","1"]
VB_HUB_ID=kevin-demo
VB_DAILY_SMS_CAP=100
VB_SMS_PRICE_PER_SEGMENT=0
VB_CALLBACK_MAX_ATTEMPTS=3
VB_CALLBACK_RETRY_SECONDS=30
VB_BOB_TIMEOUT_SECONDS=30
VB_SYNC_TRANSPORT=loopback
VB_ANDROID_ENABLED=0
VB_ANDROID_ANSWER_TIMEOUT_SECONDS=45
# On the verified Samsung/Phone Link route, wait for Bluetooth before prompts:
# VB_ANDROID_REQUIRED_AUDIO_ROUTE=TYPE_BLUETOOTH_SCO
VB_ANDROID_AUDIO_ROUTE_TIMEOUT_SECONDS=60
# Set the local numbering prefix for call-log entries without a leading +:
# VB_COUNTRY_CODE=+1
# VB_ADB=<absolute path to adb.exe>
# VB_ANDROID_SERIAL=<from adb devices>
# VB_AUDIO_INPUT=<verified receiver device index or name>
# For PC speaker receive capture: VB_AUDIO_INPUT=loopback:Speaker (Realtek(R) Audio)
# VB_AUDIO_OUTPUT=<verified transmitter device index or name>
# Verified manual Phone Link transmit: VB_AUDIO_OUTPUT=wasapi:CABLE Input (VB-Audio Virtual Cable)
# VB_SMS_LINE_ID=android-1
# VB_SMS_GATE_URL=http://127.0.0.1:8080
# VB_SMS_GATE_USER=<local username>
# VB_SMS_GATE_PASSWORD=<local password>
# VB_SMS_WEBHOOK_TOKEN=<random local secret>
# VB_CENTRAL_PHONE=<E.164 destination>
# VB_SYNC_KEY_HEX=<64 random hexadecimal characters, same at Central>
